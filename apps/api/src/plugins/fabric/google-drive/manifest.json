      "delivery": {
        "mode": "polling",
        "recommendedPollSeconds": 60
      },
      "parameters": {
        "type": "object",
        "properties": {
          "folderId": {
            "type": "string",
            "description": "Optional Drive folder ID to watch.",
            "x-label": "Folder ID",
            "x-input-type": "text"
          },
          "resourceId": {
            "type": "string",
            "description": "Only accept events for this provider resource ID, such as issue, file, row, video, page, or card ID.",
            "x-label": "Resource ID",
            "x-input-type": "text"
          },
          "resourceType": {
            "type": "string",
            "description": "Only accept this provider resource type. Example: issue, file, row, video, page.",
