{
  "metadata": {
    "id": "google-drive",
    "name": "Google Drive",
    "description": "Interact with Google Drive to upload, download, list, move, copy and manage files and folders.",
    "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/google-drive.svg",
    "categories": [
      "Apps",
      "Files"
    ],
    "author": "Fabric",
    "version": "1.1.0",
    "repository": "https://github.com/Auvexis/fabric"
  },
  "methods": {
    "listFiles": {
      "metadata": {
        "label": "List Files",
        "description": "List files and folders in Google Drive with optional filtering and sorting."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "pageSize": {
            "type": "integer",
            "description": "Number of files to return (1-100). Default is 10.",
            "default": 10,
            "minimum": 1,
            "maximum": 100,
            "x-input-type": "number",
            "x-label": "Page Size"
          },
          "query": {
            "type": "string",
            "description": "Drive API query string (e.g. 'name contains \"report\"'). Trashed files are excluded automatically.",
            "x-input-type": "text",
            "x-label": "Search Query"
          },
          "orderBy": {
            "type": "string",
            "description": "Sort order for the results.",
            "default": "modifiedTime desc",
            "enum": [
              "name",
              "modifiedTime desc",
              "createdTime desc",
              "size desc"
            ],
            "x-input-type": "select",
            "x-label": "Sort By"
          },
          "showMimeFilter": {
            "type": "boolean",
            "description": "Enable filtering by MIME type (e.g. show only PDFs or images).",
            "default": false,
            "x-input-type": "toggle",
            "x-label": "Filter by File Type"
          },
          "mimeTypeFilter": {
            "type": "string",
            "description": "MIME type to filter by (e.g. 'application/pdf', 'image/jpeg', 'application/vnd.google-apps.spreadsheet').",
            "x-input-type": "text",
            "x-label": "MIME Type",
            "x-visible-if": {
              "field": "showMimeFilter",
              "operator": "equals",
              "value": true
            }
          }
        }
      },
      "responseSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "parents": {
              "type": "array",
              "x-label": "Parents"
            },
            "id": {
              "type": "string",
              "x-label": "ID"
            },
            "name": {
              "type": "string",
              "x-label": "File Name"
            },
            "mimeType": {
              "type": "string",
              "x-label": "Mime Type"
            },
            "trashed": {
              "type": "boolean",
              "x-label": "Trashed"
            },
            "modifiedTime": {
              "type": "string",
              "x-label": "Last Modified"
            },
            "size": {
              "type": "string",
              "x-label": "File Size"
            }
          }
        }
      },
      "agentTool": {
        "enabled": true,
        "name": "google_drive_list_files",
        "description": "List files and folders in Google Drive with optional filtering and sorting.",
        "sideEffect": "read",
        "requiresApproval": false,
        "timeoutMs": 30000,
        "selection": {
          "path": "$",
          "labelFields": [
            "name"
          ],
          "valueField": "id",
          "mode": "single"
        }
      }
    },
