    "uploadFile": {
      "metadata": {
        "label": "Upload File",
        "description": "Upload one or more files to Google Drive. Accepts files from the UI or binary data piped from a previous workflow step."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "description": "List of files to upload. When connected to a workflow step that outputs a file (e.g. Drive Download, HTTP Request with binary response), the executor automatically provides the Buffer — no manual base64 encoding needed.",
            "x-label": "Files",
            "x-input-type": "files",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string",
                  "description": "File name including extension."
                },
                "mimeType": {
                  "type": "string",
                  "description": "MIME type (e.g. 'application/pdf'). Use 'application/octet-stream' if unknown."
                },
                "contentBase64": {
                  "type": "string",
                  "description": "Base64-encoded file content. Used for manual uploads. Omit when connecting a pipeline Buffer."
                }
              },
              "required": [
                "filename",
                "mimeType"
              ]
            }
          },
          "parentId": {
            "type": "string",
            "description": "ID of the destination folder. Leave empty to upload to the root of My Drive.",
            "x-input-type": "text",
            "x-label": "Parent Folder ID (optional)"
          }
        },
        "required": [
          "files"
        ]
      },
      "responseSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "x-label": "ID"
            },
            "name": {
              "type": "string",
              "x-label": "File Name"
            },
            "mimeType": {
              "type": "string",
              "x-label": "Mime Type"
            },
            "parents": {
              "type": "array",
              "x-label": "Parents"
            },
            "modifiedTime": {
              "type": "string",
              "x-label": "Last Modified"
            },
            "size": {
              "type": "string",
              "x-label": "File Size"
            }
          }
        }
      },
      "agentTool": {
        "enabled": true,
        "name": "google_drive_upload_file",
        "description": "Upload one or more files to Google Drive. Accepts files from the UI or binary data piped from a previous workflow step.",
        "sideEffect": "write",
        "requiresApproval": true,
        "timeoutMs": 30000
      }
    },
