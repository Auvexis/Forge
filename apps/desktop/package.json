{
  "name": "@fabric/desktop",
  "version": "0.1.0-alpha.13",
  "description": "Fabric desktop shell.",
  "productName": "Fabric",
  "desktopName": "Fabric",
  "author": "Auvexis",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && tsx scripts/dev.mts",
    "build": "tsc && tsx scripts/copy-assets.mts",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --x64 --arm64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "test": "node --test test/**/*.test.mjs",
    "type-check": "tsc --noEmit"
  },
  "build": {
    "appId": "com.auvexis.fabric",
    "productName": "Fabric",
    "executableName": "Fabric",
    "electronVersion": "43.3.0",
    "artifactName": "Fabric-${version}-${os}-${arch}.${ext}",
    "icon": "assets/icon",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fabric"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "assets/icon.png",
      "synopsis": "Fabric automation workspace",
      "executableName": "Fabric",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Auvexis"
    },
    "publish": null
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "electron": "^43.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@renderizer/vue": "^1.1.0-beta.6"
  }
}
