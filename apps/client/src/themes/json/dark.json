{
  "$schema": "../schema/fabric-theme.schema.json",
  "id": "fabric.dark",
  "name": "Fabric Dark",
  "type": "dark",
  "tokens": {
    "bg.base": "#14110f",
    "bg.surface": "#1c1815",
    "bg.elevated": "#24201d",
    "bg.overlay": "#2c2723",
    "bg.muted": "#211d1a",
    "bg.subtle": "#3a332e",
    "bg.inverse": "#faf9f7",
    "bg.chrome": "#3a302c",
    "bg.chrome.elevated": "#4a3e39",
    "bg.chrome.hover": "rgba(255, 250, 244, 0.08)",

    "border": "rgba(255, 250, 244, 0.1)",
    "border.muted": "rgba(255, 250, 244, 0.06)",
    "border.strong": "rgba(255, 250, 244, 0.18)",
    "border.chrome": "rgba(255, 250, 244, 0.12)",

    "text.primary": "#fffaf4",
    "text.secondary": "#c8bbb5",
    "text.muted": "#9d8f88",
    "text.disabled": "#6d625d",
    "text.inverse": "#1f1a18",
    "text.chrome": "#fff7ee",
    "text.chrome.muted": "#cdbfb7",

    "sidebar.bg": "var(--fabric-bg-chrome)",
    "sidebar.border": "var(--fabric-border-chrome)",
    "sidebar.divider": "var(--fabric-border-chrome)",
    "sidebar.text": "var(--fabric-text-chrome)",
    "sidebar.text.muted": "var(--fabric-text-chrome-muted)",
    "sidebar.link.text": "var(--fabric-text-chrome)",

    "topbar.bg": "var(--fabric-bg-chrome)",
    "topbar.border": "var(--fabric-border-chrome)",
    "topbar.search.bg": "rgba(255, 250, 244, 0.06)",
    "topbar.search.border": "var(--fabric-border-chrome)",
    "topbar.search.text": "var(--fabric-text-chrome-muted)",
    "topbar.search.hover.text": "var(--fabric-text-chrome)",
    "topbar.search.hover.bg": "var(--fabric-bg-chrome-hover)",
    "topbar.kbd.bg": "transparent",
    "topbar.button.bg": "rgba(255, 250, 244, 0.08)",
    "topbar.button.text": "var(--fabric-text-chrome)",

    "button.primary.bg": "#fffaf4",
    "button.primary.text": "#1f1a18",
    "button.primary.border": "#fffaf4",
    "button.primary.hover": "#f0ede8",
    "button.primary.active": "#e5dfd7",
    "button.primary.active.text": "#1f1a18",
    "button.secondary.bg": "#24201d",
    "button.secondary.text": "var(--fabric-text-primary)",
    "button.secondary.border": "#3a332e",
    "button.secondary.hover": "#2c2723",
    "button.secondary.active": "#3a332e",
    "button.secondary.active.text": "var(--fabric-text-primary)",
    "button.ghost.bg": "transparent",
    "button.ghost.text": "var(--fabric-text-primary)",
    "button.ghost.border": "transparent",
    "button.ghost.hover": "rgba(255, 250, 244, 0.08)",
    "button.ghost.active": "rgba(255, 250, 244, 0.12)",
    "button.ghost.active.text": "var(--fabric-text-primary)",

    "input.bg": "#1c1815",
    "input.border": "#3a332e",
    "input.border.focus": "#c8bbb5",
    "input.text": "var(--fabric-text-primary)",
    "input.placeholder": "var(--fabric-text-disabled)",
    "input.disabled.bg": "var(--fabric-bg-muted)",

    "baseButton.ghost.bg": "var(--fabric-button-ghost-bg)",
    "baseButton.ghost.text": "var(--fabric-button-ghost-text)",
    "baseButton.ghost.hover.bg": "var(--fabric-button-ghost-hover)",
    "baseButton.ghost.active.bg": "var(--fabric-button-ghost-active)",
    "baseSelect.bg": "var(--fabric-input-bg)",
    "baseSelect.border": "var(--fabric-input-border)",
    "baseModal.bg": "var(--fabric-bg-surface)",
    "baseModal.border": "var(--fabric-border)",
    "appPanel.bg": "var(--fabric-bg-surface)",
    "appPanel.border": "var(--fabric-border)",
    "globalSettings.nav.active.bg": "var(--fabric-button-ghost-active)",
    "globalSettings.nav.active.text": "var(--fabric-button-ghost-active-text)"
  }
}
