    "baseCanvas.selection.border": "var(--fabric-border-brand)",
    "baseCanvas.alignmentGuide.bg": "var(--fabric-accent)",
    "baseCanvas.alignmentGuide.shadow": "rgba(111, 75, 216, 0.2)"
  }
}
