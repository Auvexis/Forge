{
  "name": "@auvexis/fabric",
  "version": "0.1.0-alpha.10",
  "description": "Local automation workspace for workflows, forms, webhooks and agent tools.",
  "main": "index.js",
  "bin": {
    "fabric": "bin/fabric.mjs"
  },
  "files": [
    "bin/",
    "scripts/serve-client-dist.mjs",
    "apps/api/dist/",
    "apps/api/package.json",
    "apps/client/dist/",
    "apps/client/package.json",
    "apps/gateway/dist/",
    "apps/gateway/package.json",
    "docs/release-docker.md",
    "docs/release-npm.md",
    "docs/remote-release-validation.md"
  ],
  "directories": {
    "doc": "docs"
  },
  "private": false,
  "scripts": {
    "dev": "concurrently -n api,client,gateway -c blue,green,magenta \"npm run dev --workspace apps/api\" \"npm run dev --workspace apps/client\" \"npm run dev --workspace apps/gateway\"",
    "dev:desktop": "concurrently -n api,client,gateway,desktop -c blue,green,magenta,cyan \"npm run dev --workspace apps/api\" \"npm run dev --workspace apps/client\" \"npm run dev --workspace apps/gateway\" \"npm run dev --prefix apps/desktop\"",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:client": "npm run dev --workspace apps/client",
    "dev:gateway": "npm run dev --workspace apps/gateway",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:vitest": "npm run test:vitest --workspaces",
    "test:node": "npm run test:node --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "type-check": "npm run type-check --workspaces --if-present",
    "ci": "npm run type-check && npm run test:vitest && npm run test:node && npm run build",
    "start": "node ./bin/fabric.mjs",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "publish:alpha": "npm publish --tag alpha --access public",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:alpha:prepare": "node scripts/prepare-release.mjs",
    "release:beta:prepare": "node scripts/prepare-release.mjs",
    "release:stable:prepare": "node scripts/prepare-release.mjs",
    "publish:beta": "npm publish --tag beta --access public",
    "publish:stable": "npm publish --tag latest --access public"
  },
  "workspaces": [
    "apps/api",
    "apps/client",
    "apps/gateway",
    "apps/desktop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Auvexis/fabric.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Auvexis/fabric/issues"
  },
  "homepage": "https://github.com/Auvexis/fabric#readme",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "concurrently": "^10.0.3",
    "tsx": "^4.23.1"
  },
  "dependencies": {
    "@auvexis/accounts": "^0.1.13",
    "@auvexis/fabric-sdk": "3.0.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.4.0",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.2",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.1",
    "@supabase/supabase-js": "^2.105.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.8.0",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.2",
    "googleapis": "^173.0.0",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "pino-pretty": "^13.1.3",
    "umzug": "^3.8.2",
    "vm2": "^3.10.5",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@rushstack/node-core-library": "5.23.1",
    "@rushstack/terminal": "0.24.0",
    "@rushstack/ts-command-line": "5.3.9",
    "ajv": "^8.20.0",
    "gaxios": "^7.1.5",
    "uuid": "11.1.1"
  }
}

