          "mimeType": { "type": "string", "label": "Mime Type" },
          "trashed": { "type": "boolean", "label": "Trashed" },
          "parents": { "type": "array", "label": "Parents" },
          "modifiedTime": { "type": "string", "label": "Last Modified" },
          "size": { "type": "string", "label": "File Size" }
        }
      },
      "ui": {
        "component": "card",
