      "ui": {
        "component": "card",
        "actions": [
          {
            "label": "Restore",
            "action": "restoreFile",
            "parameters": {
              "fileId": "{{id}}"
            },
            "visibleIf": {
              "field": "trashed",
              "equals": true
            }
          },
          {
            "label": "Download",
            "action": "downloadFile",
            "parameters": {
              "fileId": "{{id}}"
            }
          }
        ]
      }
    }
  }
