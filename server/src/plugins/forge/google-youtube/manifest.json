            "action": "dislikeVideo",
            "parameters": { "videoId": "{{videoId}}" }
          },
          {
            "label": "Subscribe",
            "action": "subscribeToChannel",
            "parameters": { "channelId": "{{channelId}}" }
          },
          {
            "label": "Unsubscribe",
            "action": "unsubscribeFromChannel",
            "parameters": { "channelId": "{{channelId}}" }
          }
        ]
      }
    },

