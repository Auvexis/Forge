    "searchVideos": {
      "metadata": {
        "label": "Search videos",
        "description": "Search for videos on YouTube."
      },
      "parameters": {
        "query": {
          "type": "string",
          "inputType": "text",
          "required": true,
          "isBase64": false
        },
        "maxResults": {
          "type": "number",
          "inputType": "number",
          "required": false,
          "isBase64": false
        },
