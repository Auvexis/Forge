          "inputType": "text",
          "required": false,
          "isBase64": false
        }
      },
      "responseSchema": {
        "type": "array",
        "x-type": "text",
        "items": {
          "type": "object",
          "properties": {
            "videoId": { "type": "string", "label": "Video ID" },
            "title": { "type": "string", "label": "Title" },
            "description": { "type": "string", "label": "Description" },
            "channelId": { "type": "string", "label": "Channel ID" },
            "channelTitle": { "type": "string", "label": "Channel" },
            "publishedAt": { "type": "string", "label": "Published At" },
            "thumbnailUrl": { "type": "string", "label": "Thumbnail" }
