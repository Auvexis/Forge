{
  "metadata": {
    "id": "google-youtube",
    "name": "Google YouTube",
    "description": "Allows the AI to interact with YouTube to search, upload, and manage videos, channels, comments, playlists, and subscriptions.",
    "icon": "https://static.vecteezy.com/system/resources/previews/023/986/704/non_2x/youtube-logo-youtube-logo-transparent-youtube-icon-transparent-free-free-png.png",
    "category": "Google",
    "author": "Forge",
    "version": "1.0.0",
    "repository": "https://github.com/Auvexis/forge"
  },

  "methods": {
    "searchVideos": {
      "metadata": {
        "label": "Search videos",
        "description": "Search for videos on YouTube."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query string.",
            "x-input-type": "text"
          },
          "maxResults": {
            "type": "integer",
            "description": "Maximum number of results.",
            "default": 10,
            "minimum": 1,
            "maximum": 50,
            "x-input-type": "number"
          },
          "pageToken": {
            "type": "string",
            "description": "Pagination token for next page.",
            "x-input-type": "text"
          },
          "order": {
            "type": "string",
            "description": "Order of results.",
            "enum": ["relevance", "date", "rating", "viewCount", "title"],
            "default": "relevance",
            "x-input-type": "text"
          }
        },
        "required": ["query"]
      },
      "responseSchema": {
        "type": "array",
        "x-forge-display": "text",
        "items": {
          "type": "object",
          "properties": {
            "videoId": { "type": "string", "x-label": "Video ID" },
            "title": { "type": "string", "x-label": "Title" },
            "description": { "type": "string", "x-label": "Description" },
            "channelId": { "type": "string", "x-label": "Channel ID" },
            "channelTitle": { "type": "string", "x-label": "Channel" },
            "publishedAt": { "type": "string", "x-label": "Published At" },
            "thumbnailUrl": { "type": "string", "x-label": "Thumbnail" }
          }
        }
      },
      "ui": {
        "component": "table",
        "actions": [
          {
            "label": "Like",
            "action": "likeVideo",
            "parameters": { "videoId": "{{videoId}}" }
          },
          {
            "label": "Dislike",
            "action": "dislikeVideo",
            "parameters": { "videoId": "{{videoId}}" }
          },
          {
            "label": "Subscribe",
            "action": "subscribeToChannel",
            "parameters": { "channelId": "{{channelId}}" }
          },
          {
            "label": "Unsubscribe",
            "action": "unsubscribeFromChannel",
            "parameters": { "channelId": "{{channelId}}" }
          }
        ]
      }
    },

