{
  "metadata": {
    "id": "google-drive",
    "name": "Google Drive",
    "description": "Allows the AI to interact with Google Drive to manage files and folders.",
    "icon": "https://static.vecteezy.com/system/resources/previews/012/871/368/non_2x/google-drive-icon-google-product-illustration-free-png.png",
    "category": "Google",
    "author": "Nod8",
    "version": "1.0.0",
    "repository": "https://github.com/Auvexis/nod8"
  },

  "methods": {
    "listFiles": {
      "metadata": {
        "label": "List files",
        "description": "List files/folders in Google Drive."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "pageSize": {
            "type": "integer",
            "description": "Number of files to return per page.",
            "default": 20,
            "minimum": 1,
            "maximum": 1000,
            "x-input-type": "number"
          },
          "query": {
            "type": "string",
            "description": "Drive API query string (e.g. 'name contains \"report\"').",
            "x-input-type": "text"
          }
        }
      },
      "responseSchema": {
        "type": "array",
        "x-nod8-display": "file",
        "items": {
          "type": "object",
          "properties": {
            "parents": { "type": "array", "x-label": "Parents" },
            "id": { "type": "string", "x-label": "ID" },
            "name": { "type": "string", "x-label": "File Name" },
            "mimeType": { "type": "string", "x-label": "Mime Type" },
            "trashed": { "type": "boolean", "x-label": "Trashed" },
            "modifiedTime": { "type": "string", "x-label": "Last Modified" },
            "size": { "type": "string", "x-label": "File Size" }
          }
        }
      },
      "ui": {
        "component": "table",
        "actions": [
          {
            "label": "Download",
            "action": "downloadFile",
            "parameters": { "fileId": "{{id}}" }
          },
          {
            "label": "Delete",
            "action": "deleteFile",
            "parameters": { "fileId": "{{id}}" }
          },
          {
            "label": "Restore",
            "action": "restoreFile",
            "parameters": { "fileId": "{{id}}" }
          }
        ]
      }
    },

    "getFileMetadata": {
      "metadata": {
        "label": "Get file metadata",
        "description": "Get metadata of a file or folder."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string",
            "description": "The ID of the file to retrieve.",
            "x-input-type": "text"
          }
        },
        "required": ["fileId"]
      },
      "responseSchema": {
        "type": "object",
        "x-nod8-display": "file",
        "properties": {
          "id": { "type": "string", "x-label": "ID" },
          "name": { "type": "string", "x-label": "File Name" },
          "mimeType": { "type": "string", "x-label": "Mime Type" },
          "trashed": { "type": "boolean", "x-label": "Trashed" },
          "parents": { "type": "array", "x-label": "Parents" },
          "modifiedTime": { "type": "string", "x-label": "Last Modified" }
        }
      },
      "ui": {
        "component": "card",
        "actions": [
          {
            "label": "Download",
            "action": "downloadFile",
            "parameters": { "fileId": "{{id}}" }
          },
          {
            "label": "Delete",
            "action": "deleteFile",
            "parameters": { "fileId": "{{id}}" }
          },
          {
            "label": "Restore",
            "action": "restoreFile",
            "parameters": { "fileId": "{{id}}" }
          }
        ]
      }
    },

    "listFolderChildren": {
      "metadata": {
        "label": "List folder children",
        "description": "List files/folders inside a specific folder."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "folderId": {
            "type": "string",
            "description": "The ID of the folder to list.",
            "x-input-type": "text"
          }
        },
        "required": ["folderId"]
      },
      "responseSchema": {
        "type": "array",
        "x-nod8-display": "file",
        "items": {
          "type": "object",
          "properties": {
            "parents": { "type": "array", "x-label": "Parents" },
            "id": { "type": "string", "x-label": "ID" },
            "name": { "type": "string", "x-label": "File Name" },
            "mimeType": { "type": "string", "x-label": "Mime Type" },
            "trashed": { "type": "boolean", "x-label": "Trashed" },
            "modifiedTime": { "type": "string", "x-label": "Last Modified" },
            "size": { "type": "string", "x-label": "File Size" }
          }
        }
      },
      "ui": {
        "component": "table",
        "actions": [
          {
            "label": "Download",
            "action": "downloadFile",
            "parameters": { "fileId": "{{id}}" }
          },
          {
            "label": "Delete",
            "action": "deleteFile",
            "parameters": { "fileId": "{{id}}" }
          },
          {
            "label": "Restore",
            "action": "restoreFile",
            "parameters": { "fileId": "{{id}}" }
          }
        ]
      }
    },

    "uploadFile": {
      "metadata": {
        "label": "Upload file",
        "description": "Upload a new file to Google Drive."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "description": "List of files to upload.",
            "x-input-type": "files",
            "items": {
              "type": "object",
              "properties": {
                "filename": { "type": "string" },
                "mimeType": { "type": "string" },
                "contentBase64": { "type": "string" }
              },
              "required": ["filename", "mimeType", "contentBase64"]
            }
          },
          "parentId": {
            "type": "string",
            "description": "The ID of the parent folder (optional).",
            "x-input-type": "text"
          }
        },
        "required": ["files"]
      },
      "responseSchema": {
        "type": "array",
        "x-nod8-display": "file",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "x-label": "ID" },
            "name": { "type": "string", "x-label": "File Name" },
            "mimeType": { "type": "string", "x-label": "Mime Type" },
            "parents": { "type": "array", "x-label": "Parents" },
            "modifiedTime": { "type": "string", "x-label": "Last Modified" },
            "size": { "type": "string", "x-label": "File Size" }
          }
        }
      },
      "ui": {
        "component": "table",
        "actions": [
          {
            "label": "Download",
            "action": "downloadFile",
            "parameters": { "fileId": "{{id}}" }
          },
          {
            "label": "Delete",
            "action": "deleteFile",
            "parameters": { "fileId": "{{id}}" }
          }
        ]
      }
    },

    "downloadFile": {
      "metadata": {
        "label": "Download file",
        "description": "Download a file from Google Drive."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string",
            "description": "The ID of the file to download.",
            "x-input-type": "text"
          }
        },
        "required": ["fileId"]
      },
      "responseSchema": {
        "type": "object",
        "x-nod8-display": "file",
        "properties": {
          "download": {
            "type": "object",
            "x-label": "Download",
            "properties": {
              "fileName": { "type": "string", "x-label": "File Name" },
              "mimeType": { "type": "string", "x-label": "Mime Type" },
              "content": { "type": "string", "x-label": "Content (Binary)" }
            }
          }
        }
      },
      "ui": {
        "component": "card",
        "download": {
          "field": "download.content",
          "fileName": "{{download.fileName}}",
          "mimeType": "{{download.mimeType}}"
        }
      }
    },

    "deleteFile": {
      "metadata": {
        "label": "Delete file",
        "description": "Move a file to trash in Google Drive."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string",
            "description": "The ID of the file to delete.",
            "x-input-type": "text"
          }
        },
        "required": ["fileId"]
      },
      "responseSchema": {
        "type": "object",
        "x-nod8-display": "file",
        "properties": {
          "id": { "type": "string", "x-label": "ID" },
          "name": { "type": "string", "x-label": "File Name" },
          "mimeType": { "type": "string", "x-label": "Mime Type" },
          "trashed": { "type": "boolean", "x-label": "Trashed" },
          "parents": { "type": "array", "x-label": "Parents" },
          "modifiedTime": { "type": "string", "x-label": "Last Modified" },
          "size": { "type": "string", "x-label": "File Size" }
        }
      },
      "ui": {
        "component": "card",
        "actions": [
          {
            "label": "Download",
            "action": "downloadFile",
            "parameters": { "fileId": "{{id}}" }
          },
          {
            "label": "Restore",
            "action": "restoreFile",
            "parameters": { "fileId": "{{id}}" }
          }
        ]
      }
    },

    "restoreFile": {
      "metadata": {
        "label": "Restore file",
        "description": "Restore a trashed file from Google Drive."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string",
            "description": "The ID of the file to restore.",
            "x-input-type": "text"
          }
        },
        "required": ["fileId"]
      },
      "responseSchema": {
        "type": "object",
        "x-nod8-display": "file",
        "properties": {
          "id": { "type": "string", "x-label": "ID" },
          "name": { "type": "string", "x-label": "File Name" },
          "mimeType": { "type": "string", "x-label": "Mime Type" },
          "trashed": { "type": "boolean", "x-label": "Trashed" },
          "parents": { "type": "array", "x-label": "Parents" },
          "modifiedTime": { "type": "string", "x-label": "Last Modified" },
          "size": { "type": "string", "x-label": "File Size" }
        }
      },
      "ui": {
        "component": "card",
        "actions": [
          {
            "label": "Download",
            "action": "downloadFile",
            "parameters": { "fileId": "{{id}}" }
          }
        ]
      }
    },

    "moveFile": {
      "metadata": {
        "label": "Move file",
        "description": "Move a file to a different folder."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string",
            "description": "The ID of the file to move.",
            "x-input-type": "text"
          },
          "parentId": {
            "type": "string",
            "description": "The ID of the destination folder.",
            "x-input-type": "text"
          }
        },
        "required": ["fileId", "parentId"]
      },
      "responseSchema": {
        "type": "object",
        "x-nod8-display": "file",
        "properties": {
          "id": { "type": "string", "x-label": "ID" },
          "name": { "type": "string", "x-label": "File Name" },
          "mimeType": { "type": "string", "x-label": "Mime Type" },
          "trashed": { "type": "boolean", "x-label": "Trashed" },
          "parents": { "type": "array", "x-label": "Parents" },
          "modifiedTime": { "type": "string", "x-label": "Last Modified" },
          "size": { "type": "string", "x-label": "File Size" }
        }
      },
      "ui": {
        "component": "card",
        "actions": [
          {
            "label": "Download",
            "action": "downloadFile",
            "parameters": { "fileId": "{{id}}" }
          },
          {
            "label": "Delete",
            "action": "deleteFile",
            "parameters": { "fileId": "{{id}}" }
          }
        ]
      }
    },

    "copyFile": {
      "metadata": {
        "label": "Copy file",
        "description": "Copy a file to a different folder."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string",
            "description": "The ID of the file to copy.",
            "x-input-type": "text"
          },
          "parentId": {
            "type": "string",
            "description": "The ID of the destination folder.",
            "x-input-type": "text"
          }
        },
        "required": ["fileId", "parentId"]
      },
      "responseSchema": {
        "type": "object",
        "x-nod8-display": "file",
        "properties": {
          "id": { "type": "string", "x-label": "ID" },
          "name": { "type": "string", "x-label": "File Name" },
          "mimeType": { "type": "string", "x-label": "Mime Type" },
          "trashed": { "type": "boolean", "x-label": "Trashed" },
          "parents": { "type": "array", "x-label": "Parents" },
          "modifiedTime": { "type": "string", "x-label": "Last Modified" },
          "size": { "type": "string", "x-label": "File Size" }
        }
      },
      "ui": {
        "component": "card",
        "actions": [
          {
            "label": "Download",
            "action": "downloadFile",
            "parameters": { "fileId": "{{id}}" }
          },
          {
            "label": "Delete",
            "action": "deleteFile",
            "parameters": { "fileId": "{{id}}" }
          }
        ]
      }
    },

    "createFolder": {
      "metadata": {
        "label": "Create folder",
        "description": "Create a new folder in Google Drive."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name for the new folder.",
            "x-input-type": "text"
          },
          "parentId": {
            "type": "string",
            "description": "The ID of the parent folder (optional).",
            "x-input-type": "text"
          }
        },
        "required": ["name"]
      },
      "responseSchema": {
        "type": "object",
        "x-nod8-display": "folder",
        "properties": {
          "id": { "type": "string", "x-label": "ID" },
          "name": { "type": "string", "x-label": "Folder Name" },
          "mimeType": { "type": "string", "x-label": "Mime Type" },
          "parents": { "type": "array", "x-label": "Parents" }
        }
      },
      "ui": {
        "component": "card",
        "actions": [
          {
            "label": "Download",
            "action": "downloadFile",
            "parameters": { "fileId": "{{id}}" }
          }
        ]
      }
    },

    "deleteFolder": {
      "metadata": {
        "label": "Delete folder",
        "description": "Move a folder to trash in Google Drive."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "folderId": {
            "type": "string",
            "description": "The ID of the folder to delete.",
            "x-input-type": "text"
          }
        },
        "required": ["folderId"]
      },
      "responseSchema": {
        "type": "object",
        "x-nod8-display": "folder",
        "properties": {
          "id": { "type": "string", "x-label": "ID" },
          "name": { "type": "string", "x-label": "Folder Name" },
          "mimeType": { "type": "string", "x-label": "Mime Type" },
          "trashed": { "type": "boolean", "x-label": "Trashed" },
          "parents": { "type": "array", "x-label": "Parents" },
          "modifiedTime": { "type": "string", "x-label": "Last Modified" }
        }
      },
      "ui": {
        "component": "card",
        "actions": [
          {
            "label": "Restore",
            "action": "restoreFile",
            "parameters": { "fileId": "{{id}}" },
            "visibleIf": { "field": "trashed", "equals": true }
          },
          {
            "label": "Download",
            "action": "downloadFile",
            "parameters": { "fileId": "{{id}}" }
          }
        ]
      }
    }
  }
}
