{
  "metadata": {
    "id": "google-gmail",
    "name": "Google Gmail",
    "description": "Integration with Google Gmail API to manage emails, threads, drafts, and labels.",
    "icon": "https://upload.wikimedia.org/wikipedia/commons/7/7e/Gmail_icon_%282020%29.svg",
    "category": "Communication",
    "author": "Nod8",
    "version": "1.0.0",
    "repository": "https://github.com/nod8/google-gmail"
  },
  "methods": {
    "listMessages": {
      "metadata": {
        "label": "List Messages",
        "description": "Lists messages in the user's mailbox."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Only return messages matching the specified query. Supports the same query format as the Gmail search box.",
            "x-label": "Search Query",
            "x-input-type": "text"
          },
          "maxResults": {
            "type": "integer",
            "description": "Maximum number of messages to return. Default is 100.",
            "default": 100,
            "x-input-type": "number",
            "x-label": "Max Results"
          },
          "labelIds": {
            "type": "string",
            "description": "Comma-separated list of label IDs. Only return messages with these labels.",
            "x-label": "Label IDs",
            "x-input-type": "text"
          }
        }
      },
      "responseSchema": {
        "type": "array",
        "x-nod8-display": "generic",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "x-label": "Message ID" },
            "threadId": { "type": "string", "x-label": "Thread ID" }
          }
        }
      },
      "ui": {
        "component": "table"
      }
    },
    "getMessage": {
      "metadata": {
        "label": "Get Message",
        "description": "Retrieves a specific message by ID."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "The ID of the message to retrieve.",
            "x-label": "Message ID",
            "x-input-type": "text"
          },
          "format": {
            "type": "string",
            "description": "The format to return the message in (e.g., 'full', 'metadata', 'minimal', 'raw'). Default is 'full'.",
            "default": "full",
            "x-label": "Format",
            "x-input-type": "text"
          }
        },
        "required": ["messageId"]
      },
      "responseSchema": {
        "type": "object",
        "x-nod8-display": "generic",
        "properties": {
          "id": { "type": "string" },
          "threadId": { "type": "string" },
          "snippet": { "type": "string" },
          "payload": { "type": "object" }
        }
      },
      "ui": {
        "component": "card"
      }
    },
    "sendMessage": {
      "metadata": {
        "label": "Send Message",
        "description": "Sends an email message."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "description": "Recipient email address.",
            "x-label": "To",
            "x-input-type": "text"
          },
          "from": {
            "type": "string",
            "description": "Optional sender alias or display name (e.g. 'My Name <email@gmail.com>').",
            "x-label": "From",
            "x-input-type": "text"
          },
          "subject": {
            "type": "string",
            "description": "Email subject.",
            "x-label": "Subject",
            "x-input-type": "text"
          },
          "body": {
            "type": "string",
            "description": "Email body (text or HTML).",
            "x-label": "Body",
            "x-input-type": "textarea"
          },
          "attachments": {
            "type": "array",
            "description": "Optional list of attachments.",
            "x-input-type": "files",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string",
                  "description": "Name of the file."
                },
                "mimeType": {
                  "type": "string",
                  "description": "MIME type of the file."
                },
                "contentBase64": {
                  "type": "string",
                  "description": "Base64 encoded content of the file."
                }
              },
              "required": ["filename", "mimeType", "contentBase64"]
            }
          }
        },
        "required": ["to", "subject", "body"]
      },
      "responseSchema": {
        "type": "object",
        "x-nod8-display": "generic",
        "properties": {
          "id": { "type": "string" },
          "threadId": { "type": "string" },
          "labelIds": { "type": "array", "items": { "type": "string" } }
        }
      },
      "ui": {
        "component": "generic"
      }
    },
    "listLabels": {
      "metadata": {
        "label": "List Labels",
        "description": "Lists all labels in the mailbox."
      },
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "responseSchema": {
        "type": "array",
        "x-nod8-display": "generic",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "type": { "type": "string" }
          }
        }
      },
      "ui": {
        "component": "table"
      }
    },
    "modifyMessageLabels": {
      "metadata": {
        "label": "Modify Message Labels",
        "description": "Adds or removes labels from a message."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "The ID of the message to modify.",
            "x-label": "Message ID",
            "x-input-type": "text"
          },
          "addLabelIds": {
            "type": "string",
            "description": "Comma-separated list of label IDs to add.",
            "x-label": "Add Label IDs",
            "x-input-type": "text"
          },
          "removeLabelIds": {
            "type": "string",
            "description": "Comma-separated list of label IDs to remove.",
            "x-label": "Remove Label IDs",
            "x-input-type": "text"
          }
        },
        "required": ["messageId"]
      },
      "responseSchema": {
        "type": "object",
        "x-nod8-display": "generic",
        "properties": {
          "id": { "type": "string" },
          "threadId": { "type": "string" },
          "labelIds": { "type": "array", "items": { "type": "string" } }
        }
      },
      "ui": {
        "component": "generic"
      }
    },
    "listDrafts": {
      "metadata": {
        "label": "List Drafts",
        "description": "Lists drafts in the user's mailbox."
      },
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "responseSchema": {
        "type": "array",
        "x-nod8-display": "generic",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "message": { "type": "object" }
          }
        }
      },
      "ui": {
        "component": "table"
      }
    },
    "createDraft": {
      "metadata": {
        "label": "Create Draft",
        "description": "Creates a new draft message."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "description": "Recipient email address.",
            "x-label": "To",
            "x-input-type": "text"
          },
          "from": {
            "type": "string",
            "description": "Optional sender alias or display name (e.g. 'My Name <email@gmail.com>').",
            "x-label": "From",
            "x-input-type": "text"
          },
          "subject": {
            "type": "string",
            "description": "Email subject.",
            "x-label": "Subject",
            "x-input-type": "text"
          },
          "body": {
            "type": "string",
            "description": "Email body (text or HTML).",
            "x-label": "Body",
            "x-input-type": "textarea"
          },
          "attachments": {
            "type": "array",
            "description": "Optional list of attachments.",
            "x-input-type": "files",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string",
                  "description": "Name of the file."
                },
                "mimeType": {
                  "type": "string",
                  "description": "MIME type of the file."
                },
                "contentBase64": {
                  "type": "string",
                  "description": "Base64 encoded content of the file."
                }
              },
              "required": ["filename", "mimeType", "contentBase64"]
            }
          }
        },
        "required": ["to", "subject", "body"]
      },
      "responseSchema": {
        "type": "object",
        "x-nod8-display": "generic",
        "properties": {
          "id": { "type": "string" },
          "message": { "type": "object" }
        }
      },
      "ui": {
        "component": "generic"
      }
    },
    "trashMessage": {
      "metadata": {
        "label": "Trash Message",
        "description": "Moves a message to the trash."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "The ID of the message to trash.",
            "x-label": "Message ID",
            "x-input-type": "text"
          }
        },
        "required": ["messageId"]
      },
      "responseSchema": {
        "type": "object",
        "x-nod8-display": "generic",
        "properties": {
          "id": { "type": "string" },
          "threadId": { "type": "string" },
          "labelIds": { "type": "array", "items": { "type": "string" } }
        }
      },
      "ui": { "component": "generic" }
    },
    "listThreads": {
      "metadata": {
        "label": "List Threads",
        "description": "Lists threads in the user's mailbox."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query.",
            "x-label": "Search Query",
            "x-input-type": "text"
          },
          "maxResults": {
            "type": "integer",
            "description": "Max results.",
            "default": 100,
            "x-input-type": "number",
            "x-label": "Max Results"
          }
        }
      },
      "responseSchema": {
        "type": "array",
        "x-nod8-display": "generic",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "snippet": { "type": "string" },
            "historyId": { "type": "string" }
          }
        }
      },
      "ui": { "component": "table" }
    },
    "getAttachment": {
      "metadata": {
        "label": "Get Attachment",
        "description": "Gets the specified message attachment."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "The ID of the message.",
            "x-label": "Message ID",
            "x-input-type": "text"
          },
          "attachmentId": {
            "type": "string",
            "description": "The ID of the attachment.",
            "x-label": "Attachment ID",
            "x-input-type": "text"
          }
        },
        "required": ["messageId", "attachmentId"]
      },
      "responseSchema": {
        "type": "object",
        "x-nod8-display": "media",
        "properties": {
          "attachmentId": { "type": "string" },
          "size": { "type": "number" },
          "data": { "type": "string" }
        }
      },
      "ui": { "component": "generic" }
    }
  }
}
