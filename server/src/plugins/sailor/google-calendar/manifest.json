{
  "metadata": {
    "id": "google-calendar",
    "name": "Google Calendar",
    "description": "List calendars, manage events, and query free/busy availability.",
    "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/google-calendar.svg",
    "category": "Google",
    "author": "Sailor",
    "version": "1.0.0",
    "repository": "https://github.com/Auvexis/sailor"
  },
  "methods": {
    "listCalendars": {
      "metadata": {
        "label": "List Calendars",
        "description": "Lists calendars."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "maxResults": {
            "type": "number",
            "default": 100,
            "x-label": "Max Results",
            "x-input-type": "number"
          }
        }
      },
      "responseSchema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "agentTool": {
        "enabled": true,
        "name": "google_calendar_list_calendars",
        "description": "Allow an AI Agent to run Lists calendars. when explicitly enabled.",
        "sideEffect": "read",
        "requiresApproval": false,
        "timeoutMs": 30000
      }
    },
    "listEvents": {
      "metadata": {
        "label": "List Events",
        "description": "Lists events."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "calendarId": {
            "type": "string",
            "x-label": "Calendar",
            "x-input-type": "select",
            "x-dynamic-options": {
              "method": "listCalendars",
              "labelPath": "summary",
              "valuePath": "id"
            }
          },
          "timeMin": {
            "type": "string",
            "x-label": "Time Min",
            "x-input-type": "text"
          },
          "timeMax": {
            "type": "string",
            "x-label": "Time Max",
            "x-input-type": "text"
          },
          "q": {
            "type": "string",
            "x-label": "Search",
            "x-input-type": "text"
          },
          "maxResults": {
            "type": "number",
            "default": 50,
            "x-label": "Max Results",
            "x-input-type": "number"
          }
        },
        "required": [
          "calendarId"
        ]
      },
      "responseSchema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "agentTool": {
        "enabled": true,
        "name": "google_calendar_list_events",
        "description": "Allow an AI Agent to run Lists events. when explicitly enabled.",
        "sideEffect": "read",
        "requiresApproval": false,
        "timeoutMs": 30000
      }
    },
