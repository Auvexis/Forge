{
  "metadata": {
    "id": "google-sheets",
    "name": "Google Sheets",
    "description": "List, read, append, update, clear, create, delete, find, and upsert rows in Google Sheets.",
    "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/google-sheets.svg",
    "category": "Google",
    "author": "Sailor",
    "version": "1.0.0",
    "repository": "https://github.com/Auvexis/sailor"
  },
  "methods": {
    "listSpreadsheets": { "metadata": { "label": "List Spreadsheets", "description": "Lists available spreadsheets." }, "parameters": { "type": "object", "properties": {} }, "responseSchema": { "type": "array", "items": { "type": "object" } } },
    "listSheets": { "metadata": { "label": "List Sheets", "description": "Lists sheets and metadata in a spreadsheet." }, "parameters": { "type": "object", "properties": { "spreadsheetId": { "type": "string", "x-label": "Spreadsheet", "x-input-type": "select", "x-dynamic-options": { "method": "listSpreadsheets", "labelPath": "name", "valuePath": "id" } } }, "required": ["spreadsheetId"] }, "responseSchema": { "type": "array", "items": { "type": "object" } } },
    "readRows": { "metadata": { "label": "Read Rows", "description": "Reads rows from a range." }, "parameters": { "type": "object", "properties": { "spreadsheetId": { "type": "string", "x-label": "Spreadsheet", "x-input-type": "select", "x-dynamic-options": { "method": "listSpreadsheets", "labelPath": "name", "valuePath": "id" } }, "range": { "type": "string", "default": "Sheet1", "x-label": "Range", "x-input-type": "text" }, "includeHeader": { "type": "boolean", "default": true, "x-label": "First Row As Header", "x-input-type": "toggle" } }, "required": ["spreadsheetId", "range"] }, "responseSchema": { "type": "array", "items": { "type": "object" } } },
    "appendRow": { "metadata": { "label": "Append Row", "description": "Appends one row." }, "parameters": { "type": "object", "properties": { "spreadsheetId": { "type": "string", "x-label": "Spreadsheet", "x-input-type": "select", "x-dynamic-options": { "method": "listSpreadsheets", "labelPath": "name", "valuePath": "id" } }, "range": { "type": "string", "default": "Sheet1", "x-label": "Range", "x-input-type": "text" }, "values": { "type": "string", "x-label": "Values JSON Array", "x-input-type": "json" } }, "required": ["spreadsheetId", "range", "values"] }, "responseSchema": { "type": "object" } },
    "appendRows": { "metadata": { "label": "Append Rows", "description": "Appends multiple rows." }, "parameters": { "type": "object", "properties": { "spreadsheetId": { "type": "string", "x-label": "Spreadsheet", "x-input-type": "select", "x-dynamic-options": { "method": "listSpreadsheets", "labelPath": "name", "valuePath": "id" } }, "range": { "type": "string", "default": "Sheet1", "x-label": "Range", "x-input-type": "text" }, "rows": { "type": "string", "x-label": "Rows JSON Array", "x-input-type": "json" } }, "required": ["spreadsheetId", "range", "rows"] }, "responseSchema": { "type": "object" } },
    "updateRange": { "metadata": { "label": "Update Range", "description": "Updates a range." }, "parameters": { "type": "object", "properties": { "spreadsheetId": { "type": "string", "x-label": "Spreadsheet", "x-input-type": "select", "x-dynamic-options": { "method": "listSpreadsheets", "labelPath": "name", "valuePath": "id" } }, "range": { "type": "string", "x-label": "Range", "x-input-type": "text" }, "values": { "type": "string", "x-label": "Values JSON Array", "x-input-type": "json" } }, "required": ["spreadsheetId", "range", "values"] }, "responseSchema": { "type": "object" } },
    "clearRange": { "metadata": { "label": "Clear Range", "description": "Clears a range with confirmation." }, "parameters": { "type": "object", "properties": { "spreadsheetId": { "type": "string", "x-label": "Spreadsheet", "x-input-type": "select", "x-dynamic-options": { "method": "listSpreadsheets", "labelPath": "name", "valuePath": "id" } }, "range": { "type": "string", "x-label": "Range", "x-input-type": "text" }, "confirm": { "type": "boolean", "default": false, "x-label": "Confirm Clear", "x-input-type": "toggle" } }, "required": ["spreadsheetId", "range", "confirm"] }, "responseSchema": { "type": "object" } },
    "createSheet": { "metadata": { "label": "Create Sheet", "description": "Creates a sheet tab." }, "parameters": { "type": "object", "properties": { "spreadsheetId": { "type": "string", "x-label": "Spreadsheet", "x-input-type": "select", "x-dynamic-options": { "method": "listSpreadsheets", "labelPath": "name", "valuePath": "id" } }, "sheetName": { "type": "string", "x-label": "Sheet Name", "x-input-type": "text" } }, "required": ["spreadsheetId", "sheetName"] }, "responseSchema": { "type": "object" } },
    "deleteSheet": { "metadata": { "label": "Delete Sheet", "description": "Deletes a sheet tab with confirmation." }, "parameters": { "type": "object", "properties": { "spreadsheetId": { "type": "string", "x-label": "Spreadsheet", "x-input-type": "select", "x-dynamic-options": { "method": "listSpreadsheets", "labelPath": "name", "valuePath": "id" } }, "sheetId": { "type": "number", "x-label": "Sheet ID", "x-input-type": "number" }, "confirm": { "type": "boolean", "default": false, "x-label": "Confirm Delete", "x-input-type": "toggle" } }, "required": ["spreadsheetId", "sheetId", "confirm"] }, "responseSchema": { "type": "object" } },
    "findRows": { "metadata": { "label": "Find Rows", "description": "Finds rows by header key and value." }, "parameters": { "type": "object", "properties": { "spreadsheetId": { "type": "string", "x-label": "Spreadsheet", "x-input-type": "select", "x-dynamic-options": { "method": "listSpreadsheets", "labelPath": "name", "valuePath": "id" } }, "range": { "type": "string", "default": "Sheet1", "x-label": "Range", "x-input-type": "text" }, "keyColumn": { "type": "string", "x-label": "Key Column", "x-input-type": "text" }, "keyValue": { "type": "string", "x-label": "Key Value", "x-input-type": "text" } }, "required": ["spreadsheetId", "range", "keyColumn", "keyValue"] }, "responseSchema": { "type": "array", "items": { "type": "object" } } },
    "upsertRowByKey": { "metadata": { "label": "Upsert Row By Key", "description": "Updates a matching row or appends a new one." }, "parameters": { "type": "object", "properties": { "spreadsheetId": { "type": "string", "x-label": "Spreadsheet", "x-input-type": "select", "x-dynamic-options": { "method": "listSpreadsheets", "labelPath": "name", "valuePath": "id" } }, "sheetName": { "type": "string", "default": "Sheet1", "x-label": "Sheet Name", "x-input-type": "text" }, "keyColumn": { "type": "string", "x-label": "Key Column", "x-input-type": "text" }, "keyValue": { "type": "string", "x-label": "Key Value", "x-input-type": "text" }, "row": { "type": "string", "x-label": "Row JSON Object", "x-input-type": "json" } }, "required": ["spreadsheetId", "sheetName", "keyColumn", "keyValue", "row"] }, "responseSchema": { "type": "object" } }
  }
}
