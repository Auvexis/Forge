{
  "metadata": {
    "id": "google-sheets",
    "name": "Google Sheets",
    "description": "List, read, append, update, clear, create, delete, find, and upsert rows in Google Sheets.",
    "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/google-sheets.svg",
    "category": "Google",
    "author": "Sailor",
    "version": "1.0.0",
    "repository": "https://github.com/Auvexis/sailor"
  },
  "methods": {
    "listSpreadsheets": {
      "metadata": {
        "label": "List Spreadsheets",
        "description": "Lists available spreadsheets."
      },
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "responseSchema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "agentTool": {
        "enabled": true,
        "name": "google_sheets_list_spreadsheets",
        "description": "Lists available spreadsheets.",
        "sideEffect": "read",
        "requiresApproval": false,
        "timeoutMs": 30000
      }
    },
    "listSheets": {
      "metadata": {
        "label": "List Sheets",
        "description": "Lists sheets and metadata in a spreadsheet."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "spreadsheetId": {
            "type": "string",
            "x-label": "Spreadsheet",
            "x-input-type": "select",
            "x-dynamic-options": {
              "method": "listSpreadsheets",
              "labelPath": "name",
              "valuePath": "id"
            }
          }
        },
        "required": [
          "spreadsheetId"
        ]
      },
      "responseSchema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "agentTool": {
        "enabled": true,
        "name": "google_sheets_list_sheets",
        "description": "Lists sheets and metadata in a spreadsheet.",
        "sideEffect": "read",
        "requiresApproval": false,
        "timeoutMs": 30000
      }
    },
    "readRows": {
      "metadata": {
        "label": "Read Rows",
        "description": "Reads rows from a range."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "spreadsheetId": {
            "type": "string",
            "x-label": "Spreadsheet",
            "x-input-type": "select",
            "x-dynamic-options": {
              "method": "listSpreadsheets",
              "labelPath": "name",
              "valuePath": "id"
            }
          },
          "range": {
            "type": "string",
            "default": "Sheet1",
            "x-label": "Range",
            "x-input-type": "text"
          },
          "includeHeader": {
            "type": "boolean",
            "default": true,
            "x-label": "First Row As Header",
            "x-input-type": "toggle"
          }
        },
        "required": [
          "spreadsheetId",
          "range"
        ]
      },
      "responseSchema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "agentTool": {
        "enabled": true,
        "name": "google_sheets_read_rows",
        "description": "Reads rows from a range.",
        "sideEffect": "read",
        "requiresApproval": false,
        "timeoutMs": 30000
      }
    },
    "appendRow": {
      "metadata": {
        "label": "Append Row",
        "description": "Appends one row."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "spreadsheetId": {
            "type": "string",
            "x-label": "Spreadsheet",
