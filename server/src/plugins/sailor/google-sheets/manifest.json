            "type": "string",
            "default": "Sheet1",
            "x-label": "Range",
            "x-input-type": "text"
          },
          "values": {
            "type": "string",
            "x-label": "Values JSON Array",
            "x-input-type": "json"
          }
        },
        "required": [
          "spreadsheetId",
          "range",
          "values"
        ]
      },
      "responseSchema": {
        "type": "object"
      },
      "agentTool": {
        "enabled": true,
        "name": "google_sheets_append_row",
        "description": "Allow an AI Agent to run Appends one row. when explicitly enabled.",
        "sideEffect": "write",
        "requiresApproval": true,
        "timeoutMs": 30000
      }
    },
