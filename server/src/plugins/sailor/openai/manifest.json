{
  "metadata": {
    "id": "openai",
    "name": "OpenAI",
    "description": "Use OpenAI Responses, Chat Completions, structured outputs, classification, summaries, extraction, and image generation.",
    "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/openai-light.svg",
    "iconDark": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/openai.svg",
    "iconLight": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/openai-light.svg",
    "categories": [
      "AI"
    ],
    "author": "Sailor",
    "version": "1.0.0",
    "repository": "https://github.com/Auvexis/sailor",
    "agentCapabilities": {
      "chatModel": {
        "enabled": true,
        "adapter": "openai-compatible",
        "label": "OpenAI Chat Model",
        "description": "Use the OpenAI Responses API as an Agent Chat Model.",
        "defaultModel": "gpt-4.1-mini",
        "defaultBaseUrl": "https://api.openai.com/v1",
        "credentialPluginId": "openai",
        "thinking": {
          "enabled": false
        }
      }
    }
  },
  "methods": {
    "listModels": {
      "metadata": {
        "label": "List Models",
        "description": "Lists OpenAI models."
      },
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "responseSchema": {
        "type": "object"
      },
      "agentTool": {
        "enabled": true,
        "name": "openai_list_models",
        "description": "Lists OpenAI models.",
        "sideEffect": "read",
        "requiresApproval": false,
        "timeoutMs": 30000
      }
    },
    "createResponse": {
      "metadata": {
        "label": "Create Response",
        "description": "Creates a response with the Responses API."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "x-label": "Model",
            "x-input-type": "text"
          },
          "input": {
            "type": "string",
            "x-label": "Input",
            "x-input-type": "textarea"
          },
          "instructions": {
            "type": "string",
            "x-label": "Instructions",
            "x-input-type": "textarea"
          },
          "temperature": {
            "type": "number",
            "x-label": "Temperature",
            "x-input-type": "number"
          },
          "maxOutputTokens": {
            "type": "number",
            "x-label": "Max Output Tokens",
            "x-input-type": "number"
          }
        },
        "required": [
          "model",
          "input"
        ]
      },
      "responseSchema": {
        "type": "object"
      },
      "agentTool": {
        "enabled": true,
        "name": "openai_create_response",
        "description": "Creates a response with the Responses API.",
        "sideEffect": "write",
        "requiresApproval": true,
        "timeoutMs": 30000
      }
    },
    "chatCompletion": {
      "metadata": {
        "label": "Chat Completion",
        "description": "Creates a Chat Completions response."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "x-label": "Model",
            "x-input-type": "text"
          },
          "messages": {
            "type": "string",
            "x-label": "Messages JSON",
            "x-input-type": "json"
          },
          "temperature": {
            "type": "number",
            "x-label": "Temperature",
            "x-input-type": "number"
          },
          "maxTokens": {
            "type": "number",
            "x-label": "Max Tokens",
            "x-input-type": "number"
          }
        },
        "required": [
          "model",
          "messages"
        ]
      },
      "responseSchema": {
        "type": "object"
      },
      "agentTool": {
        "enabled": true,
        "name": "openai_chat_completion",
        "description": "Creates a Chat Completions response.",
        "sideEffect": "read",
        "requiresApproval": false,
        "timeoutMs": 30000
      }
    },
    "structuredResponse": {
      "metadata": {
        "label": "Structured Response",
        "description": "Creates a structured JSON response."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "x-label": "Model",
            "x-input-type": "text"
          },
          "input": {
            "type": "string",
            "x-label": "Input",
            "x-input-type": "textarea"
          },
          "instructions": {
            "type": "string",
            "x-label": "Instructions",
            "x-input-type": "textarea"
          },
          "schema": {
            "type": "string",
            "x-label": "Schema JSON",
            "x-input-type": "json"
          },
          "temperature": {
            "type": "number",
            "x-label": "Temperature",
            "x-input-type": "number"
          },
          "maxOutputTokens": {
            "type": "number",
            "x-label": "Max Output Tokens",
            "x-input-type": "number"
          }
        },
        "required": [
          "model",
          "input",
          "schema"
        ]
      },
      "responseSchema": {
        "type": "object"
      },
      "agentTool": {
        "enabled": true,
        "name": "openai_structured_response",
        "description": "Creates a structured JSON response.",
        "sideEffect": "read",
        "requiresApproval": false,
        "timeoutMs": 30000
      }
    },
    "summarizeText": {
      "metadata": {
        "label": "Summarize Text",
        "description": "Summarizes text."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "x-label": "Model",
            "x-input-type": "text"
          },
          "text": {
            "type": "string",
            "x-label": "Text",
            "x-input-type": "textarea"
          },
          "instructions": {
            "type": "string",
            "x-label": "Instructions",
            "x-input-type": "textarea"
          },
          "temperature": {
            "type": "number",
            "default": 0.2,
            "x-label": "Temperature",
            "x-input-type": "number"
          },
          "maxOutputTokens": {
            "type": "number",
            "x-label": "Max Output Tokens",
            "x-input-type": "number"
          }
        },
        "required": [
          "model",
          "text"
        ]
      },
      "responseSchema": {
        "type": "object"
      },
      "agentTool": {
        "enabled": true,
        "name": "openai_summarize_text",
        "description": "Allow an AI Agent to run Summarizes text. when explicitly enabled.",
        "sideEffect": "read",
        "requiresApproval": false,
        "timeoutMs": 30000
      }
    },
    "extractJson": {
      "metadata": {
        "label": "Extract JSON",
        "description": "Extracts JSON with a schema."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "x-label": "Model",
            "x-input-type": "text"
          },
          "text": {
            "type": "string",
            "x-label": "Text",
            "x-input-type": "textarea"
          },
          "schema": {
            "type": "string",
            "x-label": "Schema JSON",
            "x-input-type": "json"
          },
          "instructions": {
            "type": "string",
            "x-label": "Instructions",
            "x-input-type": "textarea"
          },
          "temperature": {
            "type": "number",
            "default": 0,
            "x-label": "Temperature",
            "x-input-type": "number"
          },
          "maxOutputTokens": {
            "type": "number",
            "x-label": "Max Output Tokens",
            "x-input-type": "number"
          }
        },
        "required": [
          "model",
          "text",
          "schema"
        ]
      },
      "responseSchema": {
        "type": "object"
      },
      "agentTool": {
        "enabled": true,
        "name": "openai_extract_json",
        "description": "Extracts JSON with a schema.",
        "sideEffect": "read",
        "requiresApproval": false,
        "timeoutMs": 30000
      }
    },
    "classifyText": {
      "metadata": {
        "label": "Classify Text",
        "description": "Classifies text into labels."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "x-label": "Model",
            "x-input-type": "text"
          },
          "text": {
            "type": "string",
            "x-label": "Text",
            "x-input-type": "textarea"
          },
          "labels": {
            "type": "string",
            "x-label": "Labels",
            "x-input-type": "text"
          },
          "instructions": {
            "type": "string",
            "x-label": "Instructions",
            "x-input-type": "textarea"
          },
          "temperature": {
            "type": "number",
            "default": 0,
            "x-label": "Temperature",
            "x-input-type": "number"
          },
          "maxOutputTokens": {
            "type": "number",
            "x-label": "Max Output Tokens",
            "x-input-type": "number"
          }
        },
        "required": [
          "model",
          "text",
          "labels"
        ]
      },
      "responseSchema": {
        "type": "object"
      },
      "agentTool": {
        "enabled": true,
        "name": "openai_classify_text",
        "description": "Classifies text into labels.",
        "sideEffect": "read",
        "requiresApproval": false,
        "timeoutMs": 30000
      }
    },
    "generateImage": {
      "metadata": {
        "label": "Generate Image",
        "description": "Generates an image."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "default": "gpt-image-1",
            "x-label": "Model",
            "x-input-type": "text"
          },
          "prompt": {
            "type": "string",
            "x-label": "Prompt",
            "x-input-type": "textarea"
          },
          "size": {
            "type": "string",
            "x-label": "Size",
            "x-input-type": "text"
          },
          "quality": {
            "type": "string",
            "x-label": "Quality",
            "x-input-type": "text"
          },
          "n": {
            "type": "number",
            "default": 1,
            "x-label": "Count",
            "x-input-type": "number"
          }
        },
        "required": [
          "prompt"
        ]
      },
      "responseSchema": {
        "type": "object"
      },
      "agentTool": {
        "enabled": true,
        "name": "openai_generate_image",
        "description": "Allow an AI Agent to run Generates an image. when explicitly enabled.",
        "sideEffect": "read",
        "requiresApproval": false,
        "timeoutMs": 30000
      }
    }
  }
}
