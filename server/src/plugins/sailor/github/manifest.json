{
  "metadata": {
    "id": "github",
    "name": "GitHub",
    "description": "Manage repositories, issues, pull requests, comments, and workflow runs.",
    "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/github-light.svg",
    "iconLight": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/github-light.svg",
    "iconDark": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/github.svg",
    "category": "Development",
    "author": "Sailor",
    "version": "1.0.0",
    "repository": "https://github.com/Auvexis/sailor"
  },
  "methods": {
    "getRepository": {
      "metadata": {
        "label": "Get Repository",
        "description": "Gets repository metadata."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "x-label": "Owner",
            "x-input-type": "text"
          },
          "repo": {
            "type": "string",
            "x-label": "Repo",
            "x-input-type": "text"
          }
        },
        "required": [
          "owner",
          "repo"
        ]
      },
      "responseSchema": {
        "type": "object"
      },
      "agentTool": {
        "enabled": true,
        "name": "github_get_repository",
        "description": "Gets repository metadata.",
        "sideEffect": "read",
        "requiresApproval": false,
        "timeoutMs": 30000
      }
    },
    "listIssues": {
      "metadata": {
        "label": "List Issues",
        "description": "Lists repository issues."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "x-label": "Owner",
            "x-input-type": "text"
          },
          "repo": {
            "type": "string",
            "x-label": "Repo",
            "x-input-type": "text"
          },
          "state": {
            "type": "string",
            "default": "open",
            "x-label": "State",
            "x-input-type": "text"
          },
          "labels": {
            "type": "string",
            "x-label": "Labels",
            "x-input-type": "text"
          },
          "limit": {
            "type": "number",
            "default": 30,
            "x-label": "Limit",
            "x-input-type": "number"
          }
        },
        "required": [
          "owner",
          "repo"
        ]
      },
      "responseSchema": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "agentTool": {
        "enabled": true,
        "name": "github_list_issues",
        "description": "Lists repository issues.",
        "sideEffect": "read",
        "requiresApproval": false,
        "timeoutMs": 30000
      }
    },
