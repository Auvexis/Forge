{
  "metadata": {
    "id": "github",
    "name": "GitHub",
    "description": "Manage repositories, issues, pull requests, comments, and workflow runs.",
    "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/github-light.svg",
    "iconLight": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/github-light.svg",
    "iconDark": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/github.svg",
    "category": "Development",
    "author": "Sailor",
    "version": "1.0.0",
    "repository": "https://github.com/Auvexis/sailor"
  },
  "methods": {
    "getRepository": {
      "metadata": { "label": "Get Repository", "description": "Gets repository metadata." },
      "parameters": { "type": "object", "properties": { "owner": { "type": "string", "x-label": "Owner", "x-input-type": "text" }, "repo": { "type": "string", "x-label": "Repo", "x-input-type": "text" } }, "required": ["owner", "repo"] },
      "responseSchema": { "type": "object" }
    },
    "listIssues": {
      "metadata": { "label": "List Issues", "description": "Lists repository issues." },
      "parameters": { "type": "object", "properties": { "owner": { "type": "string", "x-label": "Owner", "x-input-type": "text" }, "repo": { "type": "string", "x-label": "Repo", "x-input-type": "text" }, "state": { "type": "string", "default": "open", "x-label": "State", "x-input-type": "text" }, "labels": { "type": "string", "x-label": "Labels", "x-input-type": "text" }, "limit": { "type": "number", "default": 30, "x-label": "Limit", "x-input-type": "number" } }, "required": ["owner", "repo"] },
      "responseSchema": { "type": "array", "items": { "type": "object" } }
    },
    "createIssue": {
      "metadata": { "label": "Create Issue", "description": "Creates a repository issue." },
      "parameters": { "type": "object", "properties": { "owner": { "type": "string", "x-label": "Owner", "x-input-type": "text" }, "repo": { "type": "string", "x-label": "Repo", "x-input-type": "text" }, "title": { "type": "string", "x-label": "Title", "x-input-type": "text" }, "body": { "type": "string", "x-label": "Body", "x-input-type": "textarea" }, "labels": { "type": "string", "x-label": "Labels", "x-input-type": "text" } }, "required": ["owner", "repo", "title"] },
      "responseSchema": { "type": "object" }
    },
    "updateIssue": {
      "metadata": { "label": "Update Issue", "description": "Updates an issue or pull request issue fields." },
      "parameters": { "type": "object", "properties": { "owner": { "type": "string", "x-label": "Owner", "x-input-type": "text" }, "repo": { "type": "string", "x-label": "Repo", "x-input-type": "text" }, "issueNumber": { "type": "number", "x-label": "Issue Number", "x-input-type": "number" }, "title": { "type": "string", "x-label": "Title", "x-input-type": "text" }, "body": { "type": "string", "x-label": "Body", "x-input-type": "textarea" }, "state": { "type": "string", "x-label": "State", "x-input-type": "text" }, "labels": { "type": "string", "x-label": "Labels", "x-input-type": "text" } }, "required": ["owner", "repo", "issueNumber"] },
      "responseSchema": { "type": "object" }
    },
    "addIssueComment": {
      "metadata": { "label": "Add Issue Comment", "description": "Adds a comment to an issue or pull request." },
      "parameters": { "type": "object", "properties": { "owner": { "type": "string", "x-label": "Owner", "x-input-type": "text" }, "repo": { "type": "string", "x-label": "Repo", "x-input-type": "text" }, "issueNumber": { "type": "number", "x-label": "Issue Number", "x-input-type": "number" }, "body": { "type": "string", "x-label": "Body", "x-input-type": "textarea" } }, "required": ["owner", "repo", "issueNumber", "body"] },
      "responseSchema": { "type": "object" }
    },
    "listPullRequests": {
      "metadata": { "label": "List Pull Requests", "description": "Lists repository pull requests." },
      "parameters": { "type": "object", "properties": { "owner": { "type": "string", "x-label": "Owner", "x-input-type": "text" }, "repo": { "type": "string", "x-label": "Repo", "x-input-type": "text" }, "state": { "type": "string", "default": "open", "x-label": "State", "x-input-type": "text" }, "limit": { "type": "number", "default": 30, "x-label": "Limit", "x-input-type": "number" } }, "required": ["owner", "repo"] },
      "responseSchema": { "type": "array", "items": { "type": "object" } }
    },
    "createPullRequest": {
      "metadata": { "label": "Create Pull Request", "description": "Creates a pull request." },
      "parameters": { "type": "object", "properties": { "owner": { "type": "string", "x-label": "Owner", "x-input-type": "text" }, "repo": { "type": "string", "x-label": "Repo", "x-input-type": "text" }, "title": { "type": "string", "x-label": "Title", "x-input-type": "text" }, "head": { "type": "string", "x-label": "Head", "x-input-type": "text" }, "base": { "type": "string", "x-label": "Base", "x-input-type": "text" }, "body": { "type": "string", "x-label": "Body", "x-input-type": "textarea" }, "draft": { "type": "boolean", "default": false, "x-label": "Draft", "x-input-type": "toggle" } }, "required": ["owner", "repo", "title", "head", "base"] },
      "responseSchema": { "type": "object" }
    },
    "listWorkflowRuns": {
      "metadata": { "label": "List Workflow Runs", "description": "Lists GitHub Actions workflow runs." },
      "parameters": { "type": "object", "properties": { "owner": { "type": "string", "x-label": "Owner", "x-input-type": "text" }, "repo": { "type": "string", "x-label": "Repo", "x-input-type": "text" }, "workflowId": { "type": "string", "x-label": "Workflow ID", "x-input-type": "text" }, "branch": { "type": "string", "x-label": "Branch", "x-input-type": "text" }, "status": { "type": "string", "x-label": "Status", "x-input-type": "text" }, "limit": { "type": "number", "default": 30, "x-label": "Limit", "x-input-type": "number" } }, "required": ["owner", "repo"] },
      "responseSchema": { "type": "object" }
    }
  }
}
