{
  "metadata": {
    "id": "sailor-postgresql",
    "name": "PostgreSQL",
    "description": "Connect to PostgreSQL databases running locally, in Docker, or on hosted providers.",
    "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/postgresql.svg",
    "category": "Database",
    "author": "Sailor",
    "version": "1.0.0",
    "repository": "https://github.com/Auvexis/sailor"
  },
  "methods": {
    "testConnection": {
      "metadata": {
        "label": "Test Connection",
        "description": "Connects to PostgreSQL and returns basic server information."
      },
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      }
    },
    "listSchemas": {
      "metadata": {
        "label": "List Schemas",
        "description": "Lists non-system PostgreSQL schemas."
      },
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "responseSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string"
            }
          }
        }
      }
    },
    "listTables": {
      "metadata": {
        "label": "List Tables",
        "description": "Lists tables and views in a schema."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "description": "Schema name. Default: public.",
            "default": "public",
            "x-input-type": "text"
          }
        },
        "required": []
      },
      "responseSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          }
        }
      }
    },
    "describeTable": {
      "metadata": {
        "label": "Describe Table",
        "description": "Returns columns, types, nullability, defaults, and primary key flags."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "description": "Schema name. Default: public.",
            "default": "public",
            "x-input-type": "text"
          },
          "table": {
            "type": "string",
            "description": "Table name.",
            "x-input-type": "text"
          }
        },
        "required": [
          "table"
        ]
      },
      "responseSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "nullable": {
              "type": "boolean"
            },
            "default": {
              "type": [
                "string",
                "null"
              ]
            },
            "primaryKey": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "selectRows": {
      "metadata": {
        "label": "Select Rows",
        "description": "Runs a safe SELECT with optional columns, filters, ordering, limit, and offset."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "description": "Schema name. Default: public.",
            "default": "public",
            "x-input-type": "text"
          },
          "table": {
            "type": "string",
            "description": "Table name.",
            "x-input-type": "text"
          },
          "columns": {
            "type": "array",
            "description": "Columns to select. Empty selects all.",
            "items": {
              "type": "string"
            },
            "x-input-type": "json"
          },
          "where": {
            "type": "object",
            "description": "Simple equality filters.",
            "additionalProperties": true,
            "x-input-type": "json"
          },
          "orderBy": {
            "type": "object",
            "description": "Order configuration.",
            "properties": {
              "column": {
                "type": "string"
              },
              "direction": {
                "type": "string",
                "enum": [
                  "asc",
                  "desc"
                ]
              }
            },
            "additionalProperties": false,
            "x-input-type": "json"
          },
          "limit": {
            "type": "number",
            "description": "Maximum rows. Max: 1000.",
            "default": 100,
            "x-input-type": "number"
          },
          "offset": {
            "type": "number",
            "description": "Rows to skip.",
            "default": 0,
            "x-input-type": "number"
          }
        },
        "required": [
          "table"
        ]
      },
      "responseSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "insertRow": {
      "metadata": {
        "label": "Insert Row",
        "description": "Inserts one JSON row with parameterized values."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "description": "Schema name. Default: public.",
            "default": "public",
            "x-input-type": "text"
          },
          "table": {
            "type": "string",
            "description": "Table name.",
            "x-input-type": "text"
          },
          "row": {
            "type": "object",
            "description": "Row values.",
            "additionalProperties": true,
            "x-input-type": "json"
          }
        },
        "required": [
          "table",
          "row"
        ]
      },
      "responseSchema": {
        "type": "object",
        "properties": {}
      }
    },
    "updateRows": {
      "metadata": {
        "label": "Update Rows",
        "description": "Updates rows using a simple equality filter and returns changed rows."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "description": "Schema name. Default: public.",
            "default": "public",
            "x-input-type": "text"
          },
          "table": {
            "type": "string",
            "description": "Table name.",
            "x-input-type": "text"
          },
          "patch": {
            "type": "object",
            "description": "Fields to update.",
            "additionalProperties": true,
            "x-input-type": "json"
          },
          "where": {
            "type": "object",
            "description": "Simple equality filters.",
            "additionalProperties": true,
            "x-input-type": "json"
          }
        },
        "required": [
          "table",
          "patch"
        ]
      },
      "responseSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "deleteRows": {
      "metadata": {
        "label": "Delete Rows",
        "description": "Deletes rows and requires confirm: true."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "description": "Schema name. Default: public.",
            "default": "public",
            "x-input-type": "text"
          },
          "table": {
            "type": "string",
            "description": "Table name.",
            "x-input-type": "text"
          },
          "where": {
            "type": "object",
            "description": "Simple equality filters.",
            "additionalProperties": true,
            "x-input-type": "json"
          },
          "confirm": {
            "type": "boolean",
            "description": "Must be true to delete rows.",
            "x-input-type": "toggle"
          }
        },
        "required": [
          "table",
          "confirm"
        ]
      },
      "responseSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "executeQuery": {
      "metadata": {
        "label": "Execute Query",
        "description": "Runs raw SQL only when unsafe SQL is enabled in credentials."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "sql": {
            "type": "string",
            "description": "SQL statement.",
            "x-input-type": "code"
          },
          "values": {
            "type": "array",
            "description": "Parameterized values.",
            "items": {},
            "x-input-type": "json"
          }
        },
        "required": [
          "sql"
        ]
      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "rowCount": {
            "type": [
              "number",
              "null"
            ]
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "transaction": {
      "metadata": {
        "label": "Transaction",
        "description": "Runs raw SQL statements in a transaction only when unsafe SQL is enabled."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "statements": {
            "type": "array",
            "description": "SQL statements with optional values.",
            "items": {
              "type": "object",
              "properties": {
                "sql": {
                  "type": "string"
                },
                "values": {
                  "type": "array",
                  "items": {}
                }
              },
              "required": [
                "sql"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "x-input-type": "json"
          }
        },
        "required": [
          "statements"
        ]
      },
      "responseSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "triggers": {
    "onRowInserted": {
      "metadata": {
        "label": "On Row Inserted",
        "description": "Triggers when a PostgreSQL row is inserted."
      },
      "delivery": {
        "mode": "polling",
        "recommendedPollSeconds": 60
      },
      "parameters": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "description": "Database schema.",
            "x-label": "Schema",
            "x-input-type": "text"
          },
          "table": {
            "type": "string",
            "description": "Table name.",
            "x-label": "Table",
            "x-input-type": "text"
          },
          "primaryKey": {
            "type": "string",
            "description": "Primary key column.",
            "x-label": "Primary Key",
            "x-input-type": "text"
          },
          "maxRows": {
            "type": "integer",
            "default": 100,
            "minimum": 1,
            "maximum": 1000,
            "x-label": "Max Rows",
            "x-input-type": "number"
          },
          "eventAction": {
            "type": "string",
            "description": "Only accept this event action/operation. Example: created, updated, insert, failure.",
            "x-label": "Event Action",
            "x-input-type": "text"
          }
        },
        "required": [
          "table",
          "primaryKey"
        ]
      },
      "payloadSchema": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "description": "Database event identifier."
          },
          "table": {
            "type": "string",
            "description": "Table name."
          },
          "schema": {
            "type": "string",
            "description": "Database schema."
          },
          "operation": {
            "type": "string",
            "enum": [
              "insert",
              "update",
              "query_match",
              "auth_user_created"
            ]
          },
          "row": {
            "type": "object",
            "description": "Current row."
          },
          "oldRow": {
            "type": "object",
            "description": "Previous row when available."
          },
          "raw": {
            "type": "object",
            "description": "Original provider payload."
          }
        },
        "required": [
          "eventId",
          "operation"
        ]
      }
    },
    "onRowUpdated": {
      "metadata": {
        "label": "On Row Updated",
        "description": "Triggers when a PostgreSQL row is updated."
      },
      "delivery": {
        "mode": "polling",
        "recommendedPollSeconds": 60
      },
      "parameters": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "description": "Database schema.",
            "x-label": "Schema",
            "x-input-type": "text"
          },
          "table": {
            "type": "string",
            "description": "Table name.",
            "x-label": "Table",
            "x-input-type": "text"
          },
          "primaryKey": {
            "type": "string",
            "description": "Primary key column.",
            "x-label": "Primary Key",
            "x-input-type": "text"
          },
          "maxRows": {
            "type": "integer",
            "default": 100,
            "minimum": 1,
            "maximum": 1000,
            "x-label": "Max Rows",
            "x-input-type": "number"
          },
          "eventAction": {
            "type": "string",
            "description": "Only accept this event action/operation. Example: created, updated, insert, failure.",
            "x-label": "Event Action",
            "x-input-type": "text"
          }
        },
        "required": [
          "table",
          "primaryKey"
        ]
      },
      "payloadSchema": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "description": "Database event identifier."
          },
          "table": {
            "type": "string",
            "description": "Table name."
          },
          "schema": {
            "type": "string",
            "description": "Database schema."
          },
          "operation": {
            "type": "string",
            "enum": [
              "insert",
              "update",
              "query_match",
              "auth_user_created"
            ]
          },
          "row": {
            "type": "object",
            "description": "Current row."
          },
          "oldRow": {
            "type": "object",
            "description": "Previous row when available."
          },
          "raw": {
            "type": "object",
            "description": "Original provider payload."
          }
        },
        "required": [
          "eventId",
          "operation"
        ]
      }
    },
    "onQueryMatch": {
      "metadata": {
        "label": "On Query Match",
        "description": "Triggers when a safe read query returns rows."
      },
      "delivery": {
        "mode": "polling",
        "recommendedPollSeconds": 60
      },
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Read-only SQL query.",
            "x-label": "Query",
            "x-input-type": "textarea"
          },
          "maxRows": {
            "type": "integer",
            "default": 100,
            "minimum": 1,
            "maximum": 1000,
            "x-label": "Max Rows",
            "x-input-type": "number"
          },
          "schema": {
            "type": "string",
            "description": "Database schema to watch or filter. Leave empty for provider default.",
            "x-label": "Schema",
            "x-input-type": "text"
          },
          "table": {
            "type": "string",
            "description": "Database table to watch or filter.",
            "x-label": "Table",
            "x-input-type": "text"
          },
          "primaryKey": {
            "type": "string",
            "description": "Primary key column used to dedupe and track rows.",
            "x-label": "Primary Key",
            "x-input-type": "text"
          },
          "eventAction": {
            "type": "string",
            "description": "Only accept this event action/operation. Example: created, updated, insert, failure.",
            "x-label": "Event Action",
            "x-input-type": "text"
          }
        },
        "required": [
          "query"
        ]
      },
      "payloadSchema": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "description": "Database event identifier."
          },
          "table": {
            "type": "string",
            "description": "Table name."
          },
          "schema": {
            "type": "string",
            "description": "Database schema."
          },
          "operation": {
            "type": "string",
            "enum": [
              "insert",
              "update",
              "query_match",
              "auth_user_created"
            ]
          },
          "row": {
            "type": "object",
            "description": "Current row."
          },
          "oldRow": {
            "type": "object",
            "description": "Previous row when available."
          },
          "raw": {
            "type": "object",
            "description": "Original provider payload."
          }
        },
        "required": [
          "eventId",
          "operation"
        ]
      }
    }
  }
}
