{
  "metadata": {
    "id": "sailor-postgresql",
    "name": "PostgreSQL",
    "description": "Connect to PostgreSQL databases running locally, in Docker, or on hosted providers.",
    "icon": "database",
    "category": "Database",
    "author": "Sailor",
    "version": "1.0.0",
    "repository": "https://github.com/Auvexis/sailor",
    "style": {
      "icon": "database",
      "iconColor": "rgb(34, 197, 94)",
      "bgColor": "rgba(34, 197, 94, 0.12)",
      "borderColor": "rgba(34, 197, 94, 0.4)"
    }
  },
  "methods": {
    "testConnection": {
      "metadata": {
        "label": "Test Connection",
        "description": "Connects to PostgreSQL and returns basic server information."
      },
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" }
        }
      }
    },
    "listSchemas": {
      "metadata": {
        "label": "List Schemas",
        "description": "Lists non-system PostgreSQL schemas."
      },
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "responseSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "schema": { "type": "string" }
          }
        }
      }
    },
    "listTables": {
      "metadata": {
        "label": "List Tables",
        "description": "Lists tables and views in a schema."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "description": "Schema name. Default: public.",
            "default": "public",
            "x-input-type": "text"
          }
        },
        "required": []
      },
      "responseSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "schema": { "type": "string" },
            "name": { "type": "string" },
            "type": { "type": "string" }
          }
        }
      }
    },
    "describeTable": {
      "metadata": {
        "label": "Describe Table",
        "description": "Returns columns, types, nullability, defaults, and primary key flags."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "description": "Schema name. Default: public.",
            "default": "public",
            "x-input-type": "text"
          },
          "table": {
            "type": "string",
            "description": "Table name.",
            "x-input-type": "text"
          }
        },
        "required": ["table"]
      },
      "responseSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "type": { "type": "string" },
            "nullable": { "type": "boolean" },
            "default": { "type": ["string", "null"] },
            "primaryKey": { "type": "boolean" }
          }
        }
      }
    },
    "selectRows": {
      "metadata": {
        "label": "Select Rows",
        "description": "Runs a safe SELECT with optional columns, filters, ordering, limit, and offset."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "schema": { "type": "string", "description": "Schema name. Default: public.", "default": "public", "x-input-type": "text" },
          "table": { "type": "string", "description": "Table name.", "x-input-type": "text" },
          "columns": { "type": "array", "description": "Columns to select. Empty selects all.", "items": { "type": "string" }, "x-input-type": "json" },
          "where": { "type": "object", "description": "Simple equality filters.", "additionalProperties": true, "x-input-type": "json" },
          "orderBy": {
            "type": "object",
            "description": "Order configuration.",
            "properties": {
              "column": { "type": "string" },
              "direction": { "type": "string", "enum": ["asc", "desc"] }
            },
            "additionalProperties": false,
            "x-input-type": "json"
          },
          "limit": { "type": "number", "description": "Maximum rows. Max: 1000.", "default": 100, "x-input-type": "number" },
          "offset": { "type": "number", "description": "Rows to skip.", "default": 0, "x-input-type": "number" }
        },
        "required": ["table"]
      },
      "responseSchema": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
    },
    "insertRow": {
      "metadata": {
        "label": "Insert Row",
        "description": "Inserts one JSON row with parameterized values."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "schema": { "type": "string", "description": "Schema name. Default: public.", "default": "public", "x-input-type": "text" },
          "table": { "type": "string", "description": "Table name.", "x-input-type": "text" },
          "row": { "type": "object", "description": "Row values.", "additionalProperties": true, "x-input-type": "json" }
        },
        "required": ["table", "row"]
      },
      "responseSchema": { "type": "object", "properties": {} }
    },
    "updateRows": {
      "metadata": {
        "label": "Update Rows",
        "description": "Updates rows using a simple equality filter and returns changed rows."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "schema": { "type": "string", "description": "Schema name. Default: public.", "default": "public", "x-input-type": "text" },
          "table": { "type": "string", "description": "Table name.", "x-input-type": "text" },
          "patch": { "type": "object", "description": "Fields to update.", "additionalProperties": true, "x-input-type": "json" },
          "where": { "type": "object", "description": "Simple equality filters.", "additionalProperties": true, "x-input-type": "json" }
        },
        "required": ["table", "patch"]
      },
      "responseSchema": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
    },
    "deleteRows": {
      "metadata": {
        "label": "Delete Rows",
        "description": "Deletes rows and requires confirm: true."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "schema": { "type": "string", "description": "Schema name. Default: public.", "default": "public", "x-input-type": "text" },
          "table": { "type": "string", "description": "Table name.", "x-input-type": "text" },
          "where": { "type": "object", "description": "Simple equality filters.", "additionalProperties": true, "x-input-type": "json" },
          "confirm": { "type": "boolean", "description": "Must be true to delete rows.", "x-input-type": "toggle" }
        },
        "required": ["table", "confirm"]
      },
      "responseSchema": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
    },
    "executeQuery": {
      "metadata": {
        "label": "Execute Query",
        "description": "Runs raw SQL only when unsafe SQL is enabled in credentials."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "sql": { "type": "string", "description": "SQL statement.", "x-input-type": "code" },
          "values": { "type": "array", "description": "Parameterized values.", "items": {}, "x-input-type": "json" }
        },
        "required": ["sql"]
      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "rowCount": { "type": ["number", "null"] },
          "rows": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
        }
      }
    },
    "transaction": {
      "metadata": {
        "label": "Transaction",
        "description": "Runs raw SQL statements in a transaction only when unsafe SQL is enabled."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "statements": {
            "type": "array",
            "description": "SQL statements with optional values.",
            "items": {
              "type": "object",
              "properties": {
                "sql": { "type": "string" },
                "values": { "type": "array", "items": {} }
              },
              "required": ["sql"],
              "additionalProperties": false
            },
            "minItems": 1,
            "x-input-type": "json"
          }
        },
        "required": ["statements"]
      },
      "responseSchema": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
    }
  }
}
