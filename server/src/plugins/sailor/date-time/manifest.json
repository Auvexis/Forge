{
  "metadata": {
    "id": "sailor-date-time",
    "name": "Date & Time",
    "description": "Format, parse and manipulate dates and timestamps using dayjs.",
    "icon": "calendar-clock",
    "category": "Utilities",
    "author": "Sailor",
    "version": "1.0.0",
    "utility": true,
    "style": {
      "icon": "calendar-clock",
      "iconColor": "rgb(245, 158, 11)",
      "bgColor": "rgba(245, 158, 11, 0.12)",
      "borderColor": "rgba(245, 158, 11, 0.4)"
    }
  },
  "methods": {
    "now": {
      "metadata": {
        "label": "Get Current Date/Time",
        "description": "Returns the current date and time."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "description": "Output format string (dayjs). Default: ISO 8601.",
            "x-input-type": "text"
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone (e.g. 'America/Sao_Paulo').",
            "x-input-type": "text"
          }
        }
      },
      "responseSchema": {
        "type": "object"
      },
      "agentTool": {
        "enabled": true,
        "name": "date_time_now",
        "description": "Returns the current date and time.",
        "sideEffect": "read",
        "requiresApproval": false,
        "timeoutMs": 30000
      }
    },
    "format": {
      "metadata": {
        "label": "Format Date",
        "description": "Format a date string or timestamp."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "ISO date string or Unix timestamp (ms).",
            "x-input-type": "text"
          },
          "format": {
            "type": "string",
            "description": "Output format (e.g. 'YYYY-MM-DD HH:mm:ss').",
            "x-input-type": "text"
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone (e.g. 'UTC' or 'America/Sao_Paulo').",
            "x-input-type": "text"
          }
        },
        "required": [
          "date",
          "format"
        ]
      },
      "responseSchema": {
        "type": "object"
      },
      "agentTool": {
        "enabled": true,
        "name": "date_time_format",
        "description": "Format a date string or timestamp.",
        "sideEffect": "read",
        "requiresApproval": false,
        "timeoutMs": 30000
      }
    },
    "add": {
      "metadata": {
        "label": "Add Duration",
        "description": "Add a duration to a date."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "Base date.",
            "x-input-type": "text"
          },
          "amount": {
            "type": "number",
            "description": "Amount to add.",
            "x-input-type": "number"
          },
          "unit": {
            "type": "string",
            "description": "Unit: millisecond, second, minute, hour, day, week, month, year.",
            "x-input-type": "text"
          }
        },
        "required": [
          "date",
          "amount",
          "unit"
        ]
      },
      "responseSchema": {
        "type": "object"
      },
      "agentTool": {
        "enabled": true,
        "name": "date_time_add",
        "description": "Add a duration to a date.",
        "sideEffect": "read",
        "requiresApproval": false,
        "timeoutMs": 30000
      }
    },
    "subtract": {
      "metadata": {
        "label": "Subtract Duration",
        "description": "Subtract a duration from a date."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "Base date.",
            "x-input-type": "text"
          },
          "amount": {
            "type": "number",
            "description": "Amount to subtract.",
            "x-input-type": "number"
          },
          "unit": {
            "type": "string",
            "description": "Unit: millisecond, second, minute, hour, day, week, month, year.",
            "x-input-type": "text"
          }
        },
        "required": [
          "date",
          "amount",
          "unit"
        ]
      },
      "responseSchema": {
        "type": "object"
      },
      "agentTool": {
        "enabled": true,
        "name": "date_time_subtract",
        "description": "Subtract a duration from a date.",
        "sideEffect": "read",
        "requiresApproval": false,
        "timeoutMs": 30000
      }
    },
    "diff": {
      "metadata": {
        "label": "Difference Between Dates",
        "description": "Calculate the difference between two dates."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "dateA": {
            "type": "string",
            "description": "First date.",
            "x-input-type": "text"
          },
          "dateB": {
            "type": "string",
            "description": "Second date.",
            "x-input-type": "text"
          },
          "unit": {
            "type": "string",
            "description": "Unit: millisecond, second, minute, hour, day, month, year.",
            "x-input-type": "text"
          }
        },
        "required": [
          "dateA",
          "dateB",
          "unit"
        ]
      },
      "responseSchema": {
        "type": "object"
      },
      "agentTool": {
        "enabled": true,
        "name": "date_time_diff",
        "description": "Calculate the difference between two dates.",
        "sideEffect": "read",
        "requiresApproval": false,
        "timeoutMs": 30000
      }
    }
  }
}
