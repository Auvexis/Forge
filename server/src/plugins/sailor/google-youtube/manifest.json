{
  "metadata": {
    "id": "google-youtube",
    "name": "Google YouTube",
    "description": "Allows the AI to interact with YouTube to search, upload, and manage videos, channels, comments, playlists, and subscriptions.",
    "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/youtube.svg",
    "category": "Google",
    "author": "Sailor",
    "version": "1.0.0",
    "repository": "https://github.com/Auvexis/sailor"
  },
  "methods": {
    "searchVideos": {
      "metadata": {
        "label": "Search videos",
        "description": "Search for videos on YouTube."
      },
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query string.",
            "x-input-type": "text"
          },
          "maxResults": {
            "type": "integer",
            "description": "Maximum number of results.",
            "default": 10,
            "minimum": 1,
            "maximum": 50,
            "x-input-type": "number"
          },
          "pageToken": {
            "type": "string",
            "description": "Pagination token for next page.",
            "x-input-type": "text"
          },
          "order": {
            "type": "string",
            "description": "Order of results.",
            "enum": [
              "relevance",
              "date",
              "rating",
              "viewCount",
              "title"
            ],
            "default": "relevance",
            "x-input-type": "text"
          }
        },
        "required": [
          "query"
        ]
      },
      "responseSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "videoId": {
              "type": "string",
              "x-label": "Video ID"
            },
            "title": {
              "type": "string",
              "x-label": "Title"
            },
            "description": {
              "type": "string",
              "x-label": "Description"
            },
            "channelId": {
              "type": "string",
              "x-label": "Channel ID"
            },
            "channelTitle": {
              "type": "string",
              "x-label": "Channel"
            },
            "publishedAt": {
              "type": "string",
              "x-label": "Published At"
            },
            "thumbnailUrl": {
              "type": "string",
              "x-label": "Thumbnail"
            }
          }
        }
      },
      "agentTool": {
        "enabled": true,
        "name": "google_youtube_search_videos",
        "description": "Search for videos on YouTube.",
        "sideEffect": "read",
        "requiresApproval": false,
        "timeoutMs": 30000
      }
    },
