{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nod8.auvexis.com/schemas/plugin-manifest.schema.json",
  "title": "Nod8PluginManifest",
  "description": "Validates a Nod8 plugin manifest.json file.",
  "type": "object",
  "required": ["metadata", "methods"],
  "additionalProperties": false,

  "properties": {
    "metadata": {
      "type": "object",
      "description": "Plugin identity and authorship information.",
      "required": ["id", "name", "description", "author", "category", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique plugin identifier. Use kebab-case (e.g. 'google-drive').",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": { "type": "string", "description": "Human-readable plugin name." },
        "description": { "type": "string", "description": "Short description of what this plugin does." },
        "icon": { "type": "string", "description": "URL to an icon image for the plugin." },
        "category": { "type": "string", "description": "Category grouping (e.g. 'Google', 'Storage', 'Communication')." },
        "author": { "type": "string", "description": "Author name or organization." },
        "version": {
          "type": "string",
          "description": "Semantic version string.",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "repository": { "type": "string", "description": "URL to the plugin's source repository." },
        "utility": { "type": "boolean", "description": "Whether this plugin is a utility node." },
        "style": {
          "type": "object",
          "properties": {
            "icon": { "type": "string" },
            "iconColor": { "type": "string" },
            "bgColor": { "type": "string" },
            "borderColor": { "type": "string" }
          },
          "additionalProperties": false
        }
      }
    },

    "methods": {
      "type": "object",
      "description": "Map of method names to their definitions.",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/MethodDefinition"
      }
    }
  },

  "$defs": {
    "MethodDefinition": {
      "type": "object",
      "required": ["metadata", "parameters", "responseSchema", "ui"],
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "type": "object",
          "required": ["label", "description"],
          "properties": {
            "label": { "type": "string" },
            "description": { "type": "string" }
          }
        },
        "parameters": {
          "$ref": "#/$defs/JSONSchemaObject"
        },
        "responseSchema": {
          "$ref": "#/$defs/JSONSchemaResponse"
        },
        "ui": {
          "$ref": "#/$defs/MethodUI"
        }
      }
    },

    "JSONSchemaObject": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["object"] },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/JSONSchemaProperty" }
        },
        "required": {
          "type": "array",
          "items": { "type": "string" }
        },
        "additionalProperties": { "type": "boolean" }
      }
    },

    "JSONSchemaResponse": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["object", "array"] },
        "x-nod8-display": {
          "type": "string",
          "enum": ["file", "folder", "media", "text", "generic"]
        },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/JSONSchemaProperty" }
        },
        "required": {
          "type": "array",
          "items": { "type": "string" }
        },
        "items": { "$ref": "#/$defs/JSONSchemaProperty" }
      }
    },

    "JSONSchemaProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "number", "integer", "boolean", "object", "array", "null"]
        },
        "description": { "type": "string" },
        "default": {},
        "enum": { "type": "array" },
        "format": { "type": "string" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "minLength": { "type": "integer" },
        "maxLength": { "type": "integer" },
        "pattern": { "type": "string" },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/JSONSchemaProperty" }
        },
        "required": { "type": "array", "items": { "type": "string" } },
        "items": { "$ref": "#/$defs/JSONSchemaProperty" },
        "x-input-type": {
          "type": "string",
          "enum": [
            "text", "password", "number", "url", "email",
            "file", "files", "textarea",
            "select", "multiselect", "toggle", "datetime", "code", "json"
          ]
        },
        "x-label": { "type": "string" },
        "x-nod8-display": {
          "type": "string",
          "enum": ["file", "folder", "media", "text", "generic"]
        },
        "x-nod8-icon": { "type": "string" },
        "x-dynamic-options": {
          "type": "object",
          "description": "Populates a select/multiselect by calling a plugin method at runtime.",
          "required": ["method", "labelPath", "valuePath"],
          "additionalProperties": false,
          "properties": {
            "method": { "type": "string", "description": "Method name in methods.ts to invoke." },
            "labelPath": { "type": "string", "description": "Dot-notation path for the display label in each item." },
            "valuePath": { "type": "string", "description": "Dot-notation path for the submitted value in each item." },
            "dependsOn": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Sibling field keys that, when changed, trigger a re-fetch of options."
            }
          }
        },
        "x-visible-if": {
          "type": "object",
          "description": "Conditionally renders this field based on another field's value.",
          "required": ["field", "operator", "value"],
          "additionalProperties": false,
          "properties": {
            "field": { "type": "string", "description": "Key of the sibling parameter to observe." },
            "operator": {
              "type": "string",
              "enum": ["equals", "not_equals", "in", "contains"],
              "description": "Comparison operator."
            },
            "value": { "description": "Value to compare against. Use an array for the 'in' operator." }
          }
        }
      }
    },

    "MethodUI": {
      "type": "object",
      "required": ["component"],
      "properties": {
        "component": {
          "type": "string",
          "enum": ["table", "card", "text", "generic"]
        },
        "download": {
          "type": "object",
          "required": ["field", "fileName", "mimeType"],
          "properties": {
            "field": { "type": "string" },
            "fileName": { "type": "string" },
            "mimeType": { "type": "string" }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "action", "parameters"],
            "properties": {
              "label": { "type": "string" },
              "action": { "type": "string" },
              "parameters": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "visibleIf": {
                "type": "object",
                "required": ["field", "equals"],
                "properties": {
                  "field": { "type": "string" },
                  "equals": {}
                }
              }
            }
          }
        }
      }
    }
  }
}
